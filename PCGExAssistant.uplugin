{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1.0",
  "FriendlyName": "PCGEx | Assistant",
  "Description": "AI agent integration for the PCGEx ecosystem. Registers a PCGEx toolset with the engine's experimental Toolset Registry so both the in-editor AI Assistant and external MCP clients (via the engine's Model Context Protocol server) can search the PCGEx node knowledge base, inspect the installed PCGEx plugins, and assist with graph authoring.",
  "Category": "PCG",
  "CreatedBy": "Timothé Lapetite",
  "CreatedByURL": "https://pcgex.gitbook.io/pcgex/",
  "DocsURL": "https://pcgex.gitbook.io/pcgex/",
  "SupportURL": "https://discord.gg/mde2vC5gbE",
  "EngineVersion": "5.8.0",
  "EditorOnly": true,
  "EnabledByDefault": false,
  "CanContainContent": true,
  "IsBetaVersion": false,
  "IsExperimentalVersion": true,
  "Installed": false,
  "Modules": [
    {
      "Name": "PCGExAssistant",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": [
        "Editor"
      ],
      "PlatformAllowList": [
        "Win64",
        "Mac",
        "Linux"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "PCG",
      "Enabled": true
    },
    {
      "Name": "PCGExtendedToolkit",
      "Enabled": true
    },
    {
      "Name": "ToolsetRegistry",
      "Enabled": true
    }
  ]
}
